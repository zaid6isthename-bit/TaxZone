# ============================================================
# TEMPORARY — DEVELOPMENT ONLY Docker ignore file
# ============================================================

# Host node_modules — container installs its own
node_modules

# Next.js build cache — container builds its own
.next

# Android build artifacts — irrelevant for web dev container
android/build
android/.gradle
android/app/build
android/app/.cxx

# Other build/dist directories
dist
build
out

# Git history — not needed inside container
.git
.gitignore

# Docker files themselves (no need to copy into image)
Dockerfile
docker-compose.yml
.dockerignore

# IDE / OS artifacts
.DS_Store
Thumbs.db
*.log
