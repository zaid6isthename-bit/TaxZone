# Backend
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?schema=public
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?schema=public
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=taxzone-documents
JWT_ACCESS_SECRET=replace-with-secure-secret
JWT_REFRESH_SECRET=replace-with-secure-secret
OBJECT_STORAGE_PROVIDER=supabase
PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Frontend (NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

